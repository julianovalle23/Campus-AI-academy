        2016,
        384
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const leads = $input.all().map((i) => i.json).filter((r) => r.id)\n  .map((r) => ({ id: String(r.id), fecha: r.fecha, nombre: r.nombre, correo: r.correo, programa: r.programa,\n    telefono: r.telefono ? String(r.telefono) : '', estado: r.estado, actualizado: r.actualizado, aviso: r.aviso }))\n  .sort((a, b) => String(b.fecha).localeCompare(String(a.fecha)));\nreturn [{ json: { ok: true, admin: $('Validar sesión').first().json.admin, leads } }];"
      }
    },
