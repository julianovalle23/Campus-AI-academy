      "name": "Leer petición",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        608
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const b = $json.body || {};\nconst s = (v, max) => (typeof v === 'string' ? v.trim().slice(0, max) : '');\nconst acciones = ['login', 'listar', 'detalle', 'actualizar', 'salir'];\nreturn { json: {\n  accion: acciones.includes(b.accion) ? b.accion : 'desconocida',\n  usuario: s(b.usuario, 60).toLowerCase(),\n  clave: typeof b.clave === 'string' ? b.clave.slice(0, 200) : '',\n  token: s(b.token, 200),\n  id: s(b.id, 40),\n  estado: s(b.estado, 40),\n  nota: s(b.nota, 2001),\n} };"
      }
    },
