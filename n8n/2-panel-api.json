    {
      "id": "5d34a5a3-1a45-41b1-99ac-0bb522c49c10",
      "name": "Armar detalle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        576
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const r = $('Leer solicitud').first().json || {};\nif (!r.id) return [{ json: { codigo: 404, cuerpo: { ok: false, error: 'No encontramos esa solicitud.' } } }];\nconst historial = $input.all().map((i) => i.json).filter((h) => h.fecha)\n  .map((h) => ({ fecha: h.fecha, campo: h.campo, antes: h.antes ?? '', despues: h.despues ?? '', quien: h.quien }))\n  .sort((a, b) => String(b.fecha).localeCompare(String(a.fecha)));\nconst lead = { id: String(r.id), fecha: r.fecha, nombre: r.nombre, correo: r.correo, programa: r.programa,\n  telefono: r.telefono ? String(r.telefono) : '', estado: r.estado, actualizado: r.actualizado, aviso: r.aviso };\nreturn [{ json: { codigo: 200, cuerpo: { ok: true, lead, historial } } }];"
      }
